                <semantic:inputEntry id="_dd21b3c6-e525-4982-967d-e613142d5f92">
                    <semantic:text>[101 .. 150]</semantic:text>
                </semantic:inputEntry>
                <semantic:outputEntry id="_b2a8d745-13a6-457d-a97d-25fa76f2db2a">
                    <semantic:text>"Transaction stopped"</semantic:text>
                </semantic:outputEntry>
